# Server
PORT=3001
NODE_ENV=development

# Box
BOX_CONFIG_PATH=../box_config.json
BOX_ROOT_FOLDER_ID=0

# CORS
FRONTEND_URL=http://localhost:5173

# Your Box account email (for folder collaboration visibility)
BOX_ADMIN_EMAIL=

# Database — SQLite for local dev; Postgres (RDS) for production
DB_DIALECT=sqlite
DATABASE_URL=./data/taxflow.db
# Production example:
# DB_DIALECT=postgres
# DATABASE_URL=postgresql://user:pass@your-rds-host:5432/taxflow
# DB_SCHEMA=full   — all tables (default, local dev)
# DB_SCHEMA=minimal — production: users, sessions, reset_tokens, invite_records only
DB_SCHEMA=full
# DB_SSL=true
DB_POOL_MIN=2
DB_POOL_MAX=10

# Security
DEEP_LINK_SECRET=change-me-to-a-long-random-string
ALLOW_MOCK_AUTH=true
